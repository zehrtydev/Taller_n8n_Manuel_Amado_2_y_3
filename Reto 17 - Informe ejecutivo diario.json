        "subject": "=Informe ejecutivo diario - {{ $json.fecha }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 760px; margin: 0 auto; color: #222;\">      <h2 style=\"margin-bottom: 4px;\">📊 Informe ejecutivo diario</h2>   <p style=\"margin-top: 0; color: #666;\">     Fecha: <strong>{{ $json.fecha }}</strong>   </p>    <hr>    <h3>💰 Ventas</h3>   <table style=\"width:100%; border-collapse: collapse;\">     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Valor de ventas</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>${{ Number($json.valor_ventas).toLocaleString('es-CO') }} COP</strong>       </td>     </tr>     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Negocios cerrados</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>{{ $json.negocios_cerrados }}</strong>       </td>     </tr>   </table>    <h3>🎫 Soporte</h3>   <table style=\"width:100%; border-collapse: collapse;\">     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Tickets abiertos</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>{{ $json.tickets_abiertos }}</strong>       </td>     </tr>     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Tickets cerrados</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>{{ $json.tickets_cerrados }}</strong>       </td>     </tr>     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Tickets vencidos</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>{{ $json.tickets_vencidos }}</strong>       </td>     </tr>   </table>    <h3>⚙️ Operaciones</h3>   <table style=\"width:100%; border-collapse: collapse;\">     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Procesos ejecutados</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>{{ $json.procesos_ejecutados }}</strong>       </td>     </tr>     <tr>       <td style=\"padding:8px; border-bottom:1px solid #ddd;\">Procesos fallidos</td>       <td style=\"padding:8px; border-bottom:1px solid #ddd; text-align:right;\">         <strong>{{ $json.procesos_fallidos }}</strong>       </td>     </tr>   </table>    <hr>    <h3>🧠 Resumen ejecutivo</h3>   <p style=\"line-height:1.6;\">     {{ $json.resumen_ejecutivo }}   </p>    <h3>⚠️ Riesgos</h3>   <p style=\"line-height:1.6;\">     {{ $json.riesgos }}   </p>    <h3>🔎 Temas de atención</h3>   <p style=\"line-height:1.6;\">     {{ $json.temas_atencion }}   </p>    <hr>    <p style=\"font-size:12px; color:#777;\">     Informe generado automáticamente mediante n8n.   </p>  </div>",
