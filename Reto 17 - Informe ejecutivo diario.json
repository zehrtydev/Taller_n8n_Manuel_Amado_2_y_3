    {
      "parameters": {
        "jsCode": "const rows = $input\n  .all()\n  .map(item => item.json)\n  .filter(row => row && Object.keys(row).length > 0);\n\nconst cerrados = rows.filter(\n  row => String(row.estado ?? '').trim().toUpperCase() === 'CERRADO'\n);\n\nconst valorVentas = cerrados.reduce(\n  (total, row) => total + (Number(row.valor) || 0),\n  0\n);\n\nreturn [\n  {\n    json: {\n      valor_ventas: valorVentas,\n      negocios_cerrados: cerrados.length,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -144
      ],
      "id": "28529c58-5ddb-4308-9c2b-34c0da1539d6",
      "name": "KPI Ventas"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input\n  .all()\n  .map(item => item.json)\n  .filter(row => row && Object.keys(row).length > 0);\n\nconst contarEstado = (estadoBuscado) =>\n  rows.filter(\n    row =>\n      String(row.estado ?? '').trim().toUpperCase() === estadoBuscado\n  ).length;\n\nreturn [\n  {\n    json: {\n      tickets_abiertos: contarEstado('ABIERTO'),\n      tickets_cerrados: contarEstado('CERRADO'),\n      tickets_vencidos: contarEstado('VENCIDO'),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
