      "name": "Analizar KPIs con IA"
    },
    {
      "parameters": {
        "jsCode": "const respuestaIA = $json.choices?.[0]?.message?.content ?? '{}';\n\nlet analisis;\n\ntry {\n  analisis = JSON.parse(respuestaIA);\n} catch (error) {\n  throw new Error(`La IA no devolvió JSON válido: ${respuestaIA}`);\n}\n\nconst kpis = $('Preparar informe IA').first().json;\n\nreturn [\n  {\n    json: {\n      fecha: kpis.fecha,\n\n      valor_ventas: kpis.valor_ventas,\n      negocios_cerrados: kpis.negocios_cerrados,\n\n      tickets_abiertos: kpis.tickets_abiertos,\n      tickets_cerrados: kpis.tickets_cerrados,\n      tickets_vencidos: kpis.tickets_vencidos,\n\n      procesos_ejecutados: kpis.procesos_ejecutados,\n      procesos_fallidos: kpis.procesos_fallidos,\n\n      resumen_ejecutivo: analisis.resumen_ejecutivo ?? '',\n      riesgos: analisis.riesgos ?? '',\n      temas_atencion: analisis.temas_atencion ?? '',\n    },\n  },\n];"
      },
