        "sendTo": "zehrty.dev@gmail.com",
        "subject": "=Reporte diario de vencimientos - {{ $now.setZone('America/Bogota').toFormat('yyyy-MM-dd') }}",
        "message": "={{ ` <h2>Reporte diario de vencimientos</h2>  <p>   Fecha de revisión:   <strong>${$now.setZone('America/Bogota').toFormat('yyyy-MM-dd')}</strong> </p>  <p>   Se encontraron <strong>${$json.registros_alerta.length}</strong>   documentos que requieren atención. </p>  <table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">   <thead>     <tr>       <th>ID</th>       <th>Responsable</th>       <th>Documento</th>       <th>Fecha de vencimiento</th>       <th>Días restantes</th>       <th>Estado</th>     </tr>   </thead>    <tbody>     ${$json.registros_alerta.map(r => `       <tr>         <td>${r.id}</td>         <td>${r.responsable}</td>         <td>${r.documento}</td>         <td>${r.fecha_vencimiento}</td>         <td>           ${             r.dias_restantes < 0               ? `Vencido hace ${Math.abs(r.dias_restantes)} día(s)`               : `${r.dias_restantes} día(s)`           }         </td>         <td>${r.clasificacion}</td>       </tr>     `).join('')}   </tbody> </table>  <p>   Este reporte fue generado automáticamente por el monitor corporativo de vencimientos. </p> ` }}",
