          "assignments": [
            {
              "id": "6b83f5f9-e4f5-4785-84d6-2f68ca3c547f",
              "name": "dias_restantes",
              "value": "={{ Math.round(\n  DateTime.fromISO($json.fecha_vencimiento, { zone: 'America/Bogota' })\n    .startOf('day')\n    .diff($now.setZone('America/Bogota').startOf('day'), 'days')\n    .days\n) }}",
              "type": "number"
            },
            {
              "id": "46bcb6c5-4ce4-4a00-8d15-55aaf2285dfd",
              "name": "clasificacion",
              "value": "={{   DateTime.fromISO($json.fecha_vencimiento, { zone: 'America/Bogota' })     .startOf('day')     .diff($now.setZone('America/Bogota').startOf('day'), 'days')     .days < 0     ? 'VENCIDO'     : DateTime.fromISO($json.fecha_vencimiento, { zone: 'America/Bogota' })         .startOf('day')         .diff($now.setZone('America/Bogota').startOf('day'), 'days')         .days <= 7       ? 'PRÓXIMO EN 7 DÍAS'       : DateTime.fromISO($json.fecha_vencimiento, { zone: 'America/Bogota' })           .startOf('day')           .diff($now.setZone('America/Bogota').startOf('day'), 'days')           .days <= 15         ? 'PRÓXIMO EN 15 DÍAS'         : DateTime.fromISO($json.fecha_vencimiento, { zone: 'America/Bogota' })             .startOf('day')             .diff($now.setZone('America/Bogota').startOf('day'), 'days')             .days <= 30           ? 'PRÓXIMO EN 30 DÍAS'           : 'SIN ALERTA' }}",
              "type": "string"
            },
            {
              "id": "14509c7f-2ba4-4a12-8eba-aee3d0107fe0",
              "name": "alertado_hoy",
              "value": "={{ $json.fecha_ultima_alerta === $now.setZone('America/Bogota').toFormat('yyyy-MM-dd') }}",
              "type": "boolean"
            }
          ]
        },
