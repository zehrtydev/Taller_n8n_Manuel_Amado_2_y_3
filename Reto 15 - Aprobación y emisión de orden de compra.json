              "text": "={{\n[\n  'ORDEN DE COMPRA',\n  $('Preparar orden de compra').first().json.id_solicitud,\n  '',\n  'INFORMACIÓN DE LA SOLICITUD',\n  '',\n  `Fecha: ${DateTime.fromISO($('Preparar orden de compra').first().json.fecha_solicitud).setZone('America/Bogota').toFormat('dd/MM/yyyy')}`,\n  `Solicitante: ${$('Preparar orden de compra').first().json.solicitante}`,\n  `Correo: ${$('Preparar orden de compra').first().json.correo}`,\n  `Centro de costo: ${$('Preparar orden de compra').first().json.centro_costo}`,\n  '',\n  'JUSTIFICACIÓN',\n  '',\n  $('Preparar orden de compra').first().json.justificacion,\n  '',\n  'DETALLE DE ÍTEMS',\n  '',\n  ...$('Preparar orden de compra').first().json.detalle_items.flatMap((item, index) => [\n    `${index + 1}. ${item.descripcion}`,\n    `   Cantidad: ${item.cantidad}`,\n    `   Valor unitario: $${Number(item.valor_unitario).toLocaleString('es-CO')} COP`,\n    `   Subtotal: $${Number(item.subtotal).toLocaleString('es-CO')} COP`,\n    ''\n  ]),\n  `TOTAL: $${Number($('Preparar orden de compra').first().json.total).toLocaleString('es-CO')} COP`,\n  '',\n  'APROBACIÓN',\n  '',\n  `Nivel de aprobación: ${$('Preparar orden de compra').first().json.nivel_aprobacion}`,\n  `Fecha de decisión: ${DateTime.fromISO($('Preparar orden de compra').first().json.fecha_decision).setZone('America/Bogota').toFormat('dd/MM/yyyy - hh:mm a')}`,\n  'Estado: APROBADA'\n].join('\\n')\n}}"
